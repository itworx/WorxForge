# Backend API base URL used at runtime by the browser.
# Leave empty (recommended for local dev) to use Vite's /api proxy defined below.
# Set to the full backend URL (e.g. https://api.example.com) for production builds.
VITE_API_BASE_URL=

# Vite dev proxy target - /api requests are forwarded here when VITE_API_BASE_URL is empty.
# The SignalR hub also resolves from this value: {VITE_API_BASE_URL}/hubs/notifications.
VITE_API_PROXY_TARGET=https://localhost:7235

# Google OAuth 2.0 Client ID (from Google Cloud Console - same one used in the backend).
# Required for the Google Sign-In button to render.
VITE_GOOGLE_CLIENT_ID=
